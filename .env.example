# Copia este archivo como .env (o define las variables en PowerShell) y rellena
# los valores. NUNCA subas un archivo con valores reales a Git (.env está ignorado).
#
# PowerShell (solo dura la sesión actual):
#   $env:DATABASE_URL = "postgresql+psycopg://USUARIO:CLAVE@localhost:5432/huawei_inventory"
#
# La aplicación NO carga este archivo automáticamente: define las variables en el
# entorno (PowerShell, servicio de Windows, gestor de secretos...).

# --- Base de datos (Fase 2, opcional: sin ella funciona el flujo con formulario) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/huawei_inventory
DATABASE_ECHO=false

# --- Cifrado de AK/SK en la base de datos ---
# Formato "version:clave[,version:clave]". Genera una clave con:
#   python manage.py keys generate
# La clave maestra NO debe estar en el repositorio ni en la base de datos.
INVENTORY_ENCRYPTION_KEYS=
# Versión usada para cifrar (por defecto, la mayor). Para rotar: añade la nueva
# clave, cambia esta versión y ejecuta: python manage.py keys reencrypt
INVENTORY_ENCRYPTION_KEY_VERSION=

# --- API interna multi-cliente (/api/admin, /api/clients/.../inventory) ---
# Sin login todavía: actívala solo en uso local (la app escucha en 127.0.0.1).
INVENTORY_ADMIN_API=false

# --- Concurrencia del motor de escaneo (Fase 3B; valores conservadores) ---
# Tareas simultáneas por escaneo (1 = secuencial; máx. 16)
INVENTORY_SCAN_MAX_WORKERS=4
# Tareas simultáneas del mismo servicio (límites por API/usuario de Huawei)
INVENTORY_SCAN_PER_SERVICE=2
# Tareas simultáneas en la misma región
INVENTORY_SCAN_PER_REGION=3
# Llamadas simultáneas a Huawei en todo el proceso (todas las cuentas; máx. 32)
INVENTORY_MAX_CONCURRENT_CALLS=8

# Quién ejecuta los escaneos lanzados por la API:
#   inline = el propio servidor web (BackgroundTasks; cómodo en local)
#   worker = la API solo encola; los ejecuta `python manage.py worker` (recomendado en producción)
INVENTORY_SCAN_EXECUTOR=inline

# --- Costos (Fase 4) ---
# Tabla CSV de precios mantenida por ti a partir de una fuente oficial (ver docs/COSTS.md).
# Vacío = sin fuente de precios (no se muestran importes estimados).
INVENTORY_PRICE_TABLE=

# --- Scripts de línea de comandos (test_ecs.py, test.py, manage.py --from-env) ---
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_PROJECT_ID=
HUAWEI_REGION=ap-southeast-3

# Solo test.py (endpoints explícitos, p. ej. Huawei Cloud Europa)
HUAWEI_IAM_ENDPOINT=https://iam.eu-west-101.myhuaweicloud.eu
HUAWEI_ECS_ENDPOINT=https://ecs.ap-southeast-3.myhuaweicloud.eu

# --- Tests: PostgreSQL real para migraciones (si no, se usa pgserver embebido) ---
TEST_DATABASE_URL=

# --- Seguridad de la API interna (Fase 4) ---
# Si se define (mínimo 32 caracteres), la API interna exige "Authorization: Bearer <token>".
# Si NO se define, la API interna solo acepta peticiones desde esta máquina (loopback).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
INVENTORY_ADMIN_TOKEN=
# Orígenes CORS permitidos, separados por comas (vacío = solo mismo origen; '*' no se acepta)
INVENTORY_CORS_ORIGINS=
# Dominios de endpoint adicionales permitidos (además de myhuaweicloud.com / .eu)
INVENTORY_ALLOWED_ENDPOINT_DOMAINS=

# --- Logs ---
# Nivel (DEBUG, INFO, WARNING, ERROR) y formato (text | json)
LOG_LEVEL=INFO
LOG_FORMAT=text
